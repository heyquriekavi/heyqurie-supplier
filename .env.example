# Copy to .env and fill in. .env is gitignored - never commit real keys.
# These are read by Expo at bundle time, so they are baked into any build.
# Do not put a key here that you would not ship inside the app.

# Where the supplier backend is running. localhost works in a browser on the
# same machine; use this machine's LAN address to open the app on a phone.
EXPO_PUBLIC_API_URL=http://localhost:8001

# Local testing only: with this set, the app reads bill photos by calling
# OpenRouter straight from the phone and never reaches the backend. Leave it
# empty to use the backend, which is the path production takes.
EXPO_PUBLIC_OPENROUTER_API_KEY=
