# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# this machine's API address; never a key
.env

# ---- backend ----
# Every .env, at any depth. Keys live only on the machine that runs it.
.env
**/.env
!.env.example
!**/.env.example

# Local SQLite, used only when DATABASE_URL is empty
*.db
*.db-journal
backend/app.db.bak*

# Bill photos stored on this machine: real customer paperwork, never in git
backend/uploads/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Working screenshots, not part of the app
Screenshot*.png
PHOTO-*.jpg
