# Copy to .env and fill in. .env is gitignored - never commit real keys.
# This is the supplier backend. It is separate from the retail app's backend
# and has its own database.

# --- Required ---------------------------------------------------------------

# Supabase -> Project Settings -> Database -> Connection string -> Session pooler.
# Port 5432, and URL-encode any special characters in the password.
# Leave empty to fall back to a local SQLite file, which is for tests only.
DATABASE_URL=

# Signs the 30-day access token. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Mixed into the stored OTP hash. Without it a stolen database dump can be
# brute-forced back to live codes, because only a million codes exist.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OTP_PEPPER=

# dev: no SMS is sent, the code is always 123456, and /otp/send returns it in
# the response body. production: a real SMS goes out and MSG91 must be set.
APP_ENV=dev

# --- Reading bills and answering questions ----------------------------------

# openrouter.ai/keys - the brain behind Ask Qurie.
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=

# dashboard.sarvam.ai - reads bill photos, and speech in and out.
SARVAM_API_KEY=
TTS_PROVIDER=sarvam
SARVAM_SPEAKER=priya
SARVAM_STT_MODEL=saaras:v3

# console.groq.com/keys - only used when LLM_PROVIDER=groq.
GROQ_API_KEY=

# Which languages Qurie speaks. v1 is English only; the Hindi and Tamil strings
# are written in the app already, so switching them on is this one line:
#   QURIE_VOICE_LANGS=en-IN,hi-IN,ta-IN
QURIE_VOICE_LANGS=en-IN

# Set to 0 to refuse every question that is not answerable from the ledger.
# Default answers general business questions, but never general chat.
QURIE_GENERAL_ANSWERS=1

# --- Soft copies of bills ---------------------------------------------------

# Supabase -> Project Settings -> API. The service key bypasses row security,
# so it stays server-side and never reaches the phone.
# Leave empty to store photos in a local folder instead.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=bills

# --- Sending the OTP by SMS (only needed when APP_ENV=production) -----------

# msg91.com -> Auth Key, and the OTP template you registered.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
